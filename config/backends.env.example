# mac-studio-server — optional inference backends.
#
# This is the format scripts/install.sh saves to backends.env when you pick
# backends on a terminal. The file is parsed, never sourced: one KEY=value per
# line, no quotes, no $, no export. You can also export these variables
# yourself; with MSS_BACKENDS set, install.sh uses the environment only.
# Everything is optional: with MSS_BACKENDS unset or "ollama", installation is
# identical to v1.2.0.
#
# Placeholders only: real model paths, keys, IPs and checksums are yours.

# Comma-separated selection. Valid: ollama, llamacpp, ds4, ollama,llamacpp,
# ollama,ds4. At most ONE optional backend; llamacpp,ds4 is rejected.
MSS_BACKENDS=ollama

# Ollama bind host (unchanged default from v1.2.0; 127.0.0.1 = loopback only).
OLLAMA_BIND=0.0.0.0

# Service user for every backend (historical name). Defaults to the user who
# ran sudo; root is refused.
# OLLAMA_USER=<user>

# Wired GPU memory limit in percent of RAM. When set, com.ollama.gpumemory is
# installed and an optional backend waits for the limit before it starts.
# OLLAMA_GPU_PERCENT=80

# ── llama.cpp llama-server (optional) ─────────────────────────────────────────
LLAMACPP_BIN=/path/to/llama-server
LLAMACPP_MODEL=/path/to/model.gguf
LLAMACPP_MODEL_SHA256=<sha256>
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
# Space-separated IPv4 addresses/CIDRs for the pf allowlist. Required for a
# LAN bind unless LLAMACPP_API_KEY_FILE is set.
LLAMACPP_ALLOW_FROM=
# Readable only by the service user (0600/0400); never copied into config.
LLAMACPP_API_KEY_FILE=
# Optional performance flags (llama-server defaults otherwise).
LLAMACPP_CTX=
LLAMACPP_PARALLEL=
# Allowlisted flags only (see README); unknown tokens abort the install.
LLAMACPP_EXTRA_ARGS=

# ── DwarfStar ds4-server (optional) ───────────────────────────────────────────
DS4_BIN=/path/to/ds4-server
DS4_MODEL=/path/to/model.gguf
DS4_MODEL_SHA256=<sha256>
# ds4 has no authentication: a non-loopback host REQUIRES DS4_ALLOW_FROM.
DS4_HOST=127.0.0.1
DS4_PORT=8000
DS4_ALLOW_FROM=
DS4_CTX=65536
DS4_BATCHED_SESSIONS=
# launchd WorkingDirectory; defaults to the directory of the resolved DS4_BIN.
DS4_WORKDIR=
# Allowlisted flags only (--threads, --power, --mixed-prefill-quantum, --mtp,
# --mtp-draft, --mtp-exact-sampling, --prefill-chunk, --warm-weights).
DS4_EXTRA_ARGS=

# ── guard and logs (defaults shown) ───────────────────────────────────────────
MSS_GUARD_FREE_PCT=10
MSS_GUARD_SWAP_HEADROOM_MB=2048
MSS_GUARD_STREAK=3
MSS_LOG_MAX_MB=100
