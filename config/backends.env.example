# mac-studio-server — optional inference backends.
#
# This is the format scripts/install.sh saves to backends.env when you pick
# backends on a terminal. The file is parsed, never sourced: one KEY=value per
# line, no quotes, no $, no export. You can also export these variables
# yourself; with MSS_BACKENDS set, install.sh uses the environment only.
# Everything is optional: with MSS_BACKENDS unset or "ollama", installation is
# identical to v1.2.0. scripts/backend.sh activate switches the running
# optional backend later.
#
# Placeholders only: real model paths, keys, IPs and checksums are yours.

# Comma-separated selection of any of ollama, llamacpp, ds4 and mlx. Ollama
# runs whenever it is selected; of the optional backends (llamacpp, ds4, mlx)
# ONE runs and the others stay installed on standby, ready to switch to.
MSS_BACKENDS=ollama

# The optional backend that runs: required with two or more optional backends
# (one of them, or none); with one it defaults to that one. Never ollama.
# MSS_ACTIVE_BACKEND=ds4

# Install the optional backend without a model for now (no backend or guard job
# is loaded); scripts/model.sh adds one later. One optional backend only, and
# not mlx.
# MSS_DEFER_MODEL=yes

# Ollama bind host (unchanged default from v1.2.0; 127.0.0.1 = loopback only).
OLLAMA_BIND=0.0.0.0

# Service user for every backend (historical name). Defaults to the user who
# ran sudo; root is refused.
# OLLAMA_USER=<user>

# Metal wired-memory limit in percent of RAM (1-100, or system). Shared by
# Ollama, llama.cpp, ds4 and mlx. When set, com.mac-studio-server.gpumemory is
# installed and an optional backend waits for the limit before it starts.
# Unset leaves an installed GPU boot job as it is.
# MSS_GPU_PERCENT=80

# Ollama binary, when it is not /usr/local/bin/ollama (for example Homebrew's).
# OLLAMA_BIN=/opt/homebrew/bin/ollama

# Headless macOS tweaks (scripts/optimize-mac-server.sh): yes or no. Unset runs
# them when Ollama is selected, as in 1.4.0; the picker asks once and saves it.
# MSS_TUNE_MACOS=no

# Start the Mac automatically after a power failure (pmset autorestart).
# Unset leaves the power setting as it is.
# MSS_POWER_AUTORESTART=yes

# Install Colima and the Docker CLI with Homebrew when they are missing.
# Unset installs nothing. Never changes a Colima VM.
# MSS_DOCKER_INSTALL=yes

# Start Colima at every boot (com.colima.daemon). Unset leaves the boot job as
# it is; no never stops or removes a running Colima.
# MSS_DOCKER_AUTOSTART=yes

# ── llama.cpp llama-server (optional) ─────────────────────────────────────────
LLAMACPP_BIN=/path/to/llama-server
LLAMACPP_MODEL=/path/to/model.gguf
LLAMACPP_MODEL_SHA256=<sha256>
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
# Space-separated IPv4 addresses/CIDRs for the pf allowlist. Required for a
# LAN bind unless LLAMACPP_API_KEY_FILE is set.
LLAMACPP_ALLOW_FROM=
# Readable only by the service user (0600/0400); never copied into config.
LLAMACPP_API_KEY_FILE=
# Optional performance flags (llama-server defaults otherwise).
LLAMACPP_CTX=
LLAMACPP_PARALLEL=
# Allowlisted flags only (see README); unknown tokens abort the install.
LLAMACPP_EXTRA_ARGS=

# ── DwarfStar ds4-server (optional) ───────────────────────────────────────────
DS4_BIN=/path/to/ds4-server
DS4_MODEL=/path/to/model.gguf
DS4_MODEL_SHA256=<sha256>
# ds4 has no authentication: a non-loopback host REQUIRES DS4_ALLOW_FROM.
DS4_HOST=127.0.0.1
DS4_PORT=8000
DS4_ALLOW_FROM=
DS4_CTX=65536
# Unset: 4 with 96 GB of RAM or more, otherwise 2. 1 = one session at a time.
DS4_BATCHED_SESSIONS=
# launchd WorkingDirectory; defaults to the directory of the resolved DS4_BIN.
DS4_WORKDIR=
# Allowlisted flags only (--threads, --power, --mixed-prefill-quantum, --mtp,
# --mtp-draft, --mtp-exact-sampling, --prefill-chunk, --warm-weights).
DS4_EXTRA_ARGS=

# ── MLX-Serve mlx-serve (optional) ────────────────────────────────────────────
# Exactly mlx-serve 26.10.1 (Homebrew tap ddalcu/mlx-serve; brew pin it; macOS 26.2+).
# Allowed clients reach every endpoint, including model load and pull.
MLX_BIN=/path/to/mlx-serve
# A native MLX checkpoint directory: config.json and *.safetensors at the top,
# no .gguf anywhere. Only names and sizes are checked, never contents.
MLX_MODEL_DIR=/path/to/model-dir
# mlx has no authentication: a non-loopback host REQUIRES MLX_ALLOW_FROM.
MLX_HOST=127.0.0.1
MLX_PORT=11234
MLX_ALLOW_FROM=
# Context size, 1..1048576; unset uses the model's own.
MLX_CTX=
# Allowlisted flags only (--max-concurrent, --prefill-chunk, --kv-quant,
# --prefix-cache-mem, --timeout, --metrics, --mtp, --no-mtp, --no-vision).
MLX_EXTRA_ARGS=

# ── guard and logs (defaults shown) ───────────────────────────────────────────
MSS_GUARD_FREE_PCT=10
MSS_GUARD_SWAP_HEADROOM_MB=2048
MSS_GUARD_STREAK=3
MSS_LOG_MAX_MB=100
