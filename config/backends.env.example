# mac-studio-server 1.3.0 — optional inference backends (issue #9).
#
# Copy the variables you need into your environment (or a private .env that is
# never committed) and run scripts/install.sh. Everything is optional: with
# MSS_BACKENDS unset or "ollama", installation is identical to v1.2.0.
#
# Placeholders only: real model paths, keys, IPs and checksums are yours.

# Comma-separated selection. Valid: ollama, llamacpp, ds4, ollama,llamacpp,
# ollama,ds4. At most ONE optional backend; llamacpp,ds4 is rejected.
MSS_BACKENDS=ollama

# Ollama bind host (unchanged default from v1.2.0; 127.0.0.1 = loopback only).
OLLAMA_BIND=0.0.0.0

# ── llama.cpp llama-server (optional) ─────────────────────────────────────────
LLAMACPP_BIN=/path/to/llama-server
LLAMACPP_MODEL=/path/to/model.gguf
LLAMACPP_MODEL_SHA256=<sha256>
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
# Space-separated IPv4 addresses/CIDRs for the pf allowlist. Required for a
# LAN bind unless LLAMACPP_API_KEY_FILE is set.
LLAMACPP_ALLOW_FROM=
# Readable only by the service user (0600/0400); never copied into config.
LLAMACPP_API_KEY_FILE=
# Optional performance flags (llama-server defaults otherwise).
LLAMACPP_CTX=
LLAMACPP_PARALLEL=
# Allowlisted flags only (see README); unknown tokens abort the install.
LLAMACPP_EXTRA_ARGS=

# ── DwarfStar ds4-server (optional) ───────────────────────────────────────────
DS4_BIN=/path/to/ds4-server
DS4_MODEL=/path/to/model.gguf
DS4_MODEL_SHA256=<sha256>
# ds4 has no authentication: a non-loopback host REQUIRES DS4_ALLOW_FROM.
DS4_HOST=127.0.0.1
DS4_PORT=8000
DS4_ALLOW_FROM=
DS4_CTX=65536
DS4_BATCHED_SESSIONS=
# Allowlisted flags only.
DS4_EXTRA_ARGS=

# ── guard and logs (defaults shown) ───────────────────────────────────────────
MSS_GUARD_FREE_PCT=10
MSS_GUARD_SWAP_HEADROOM_MB=2048
MSS_GUARD_STREAK=3
MSS_LOG_MAX_MB=100
