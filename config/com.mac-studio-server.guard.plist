<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed whenever an optional backend is selected; targets only that
     backend, never Ollama. RunAtLoad starts sampling at first load. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-studio-server.guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mac-studio-server/mss-guard.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
</dict>
</plist>
