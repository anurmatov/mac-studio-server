<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-studio-server.ds4</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mac-studio-server/ds4-start.sh</string>
    </array>
    <key>UserName</key>
    <string><OLLAMA_USER></string>
    <key>GroupName</key>
    <string>staff</string>
    <!-- ds4 loads Metal kernels relative to its binary; the installer renders
         the resolved DS4_BIN directory here. -->
    <key>WorkingDirectory</key>
    <string><MSS_WORKDIR></string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/log/mac-studio-server/ds4.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/mac-studio-server/ds4.log</string>
</dict>
</plist>
